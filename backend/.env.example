# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintrack_pro
DB_USER=postgres
DB_PASS=change_me

# ── JWT Secrets (generate strong random values, e.g. `openssl rand -hex 32`) ──
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI Configuration ─────────────────────────────────────────────────────────
# Set AI_ENABLED=true to use the NVIDIA / OpenAI provider.
# When AI_ENABLED=false the server returns mock replies (offline safe).
AI_ENABLED=false
AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=deepseek-ai/deepseek-v4-flash
AI_API_KEY=your_ai_provider_api_key_here
