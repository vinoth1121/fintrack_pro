# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintrack_pro
DB_USER=postgres
DB_PASS=change_me

# ── JWT Secrets (generate strong random values, e.g. `openssl rand -hex 32`) ──
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI Configuration ─────────────────────────────────────────────────────────
# Set AI_ENABLED=true to use the configured provider (Google Gemini).
# When AI_ENABLED=false the server returns mock replies (offline safe).
# Provider: google | nvidia | openai
# The server calls an OPENAI-COMPATIBLE /chat/completions endpoint. For Google
# Gemini you MUST use the OpenAI-compatible base URL below (the bare .../v1beta
# endpoint does NOT accept /chat/completions and would 404 -> mock fallback).
AI_ENABLED=false
AI_PROVIDER=google
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_ai_provider_api_key_here
