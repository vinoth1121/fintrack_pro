{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "moduleResolution": "bundler",
    "types": ["node"],
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["es2021"]
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules"]
}